<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla principal (vertical). Interfaz de MainActivity.java.
    Ningún texto, color ni medida está escrito aquí: todo sale de res/values.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra_superior"
        style="@style/Estilo.BarraSuperior" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="@dimen/tamano_logo"
                    android:layout_height="@dimen/tamano_logo"
                    android:contentDescription="@string/desc_logo"
                    android:src="@drawable/ic_logo_bitacora" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_medio"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Texto con parámetro: se rellena en MainActivity con getString(R.string.saludo, nombre) -->
                    <TextView
                        android:id="@+id/tv_saludo"
                        style="@style/Estilo.Titulo" />

                    <TextView
                        style="@style/Estilo.Subtitulo"
                        android:text="@string/subtitulo_inicio" />
                </LinearLayout>
            </LinearLayout>

            <!-- Imagen de mapa de bits (WebP) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_banner"
                android:layout_marginTop="@dimen/margen_pantalla"
                android:contentDescription="@string/desc_banner"
                android:scaleType="centerCrop"
                android:src="@drawable/img_grafico_velas"
                app:shapeAppearanceOverlay="@style/Estilo.FormaRedondeada" />

            <!-- Tarjeta: resumen semanal -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_resumen"
                style="@style/Estilo.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Estilo.TituloSeccion"
                        android:text="@string/titulo_resumen" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Estilo.Etiqueta"
                                android:text="@string/etiqueta_operaciones" />

                            <TextView
                                android:id="@+id/tv_valor_operaciones"
                                style="@style/Estilo.Titulo.Dato" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Estilo.Etiqueta"
                                android:text="@string/etiqueta_acierto" />

                            <TextView
                                android:id="@+id/tv_valor_acierto"
                                style="@style/Estilo.Titulo.Dato" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Estilo.Etiqueta"
                                android:text="@string/etiqueta_resultado" />

                            <TextView
                                android:id="@+id/tv_valor_resultado"
                                style="@style/Estilo.Titulo.Dato"
                                android:textColor="@color/color_ganancia" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta: última operación -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjeta_ultima"
                style="@style/Estilo.Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Estilo.TituloSeccion"
                        android:text="@string/titulo_ultima_operacion" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_pequeno"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Imagen vectorial teñida con el color de ganancia -->
                        <ImageView
                            android:layout_width="@dimen/tamano_icono"
                            android:layout_height="@dimen/tamano_icono"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tendencia"
                            app:tint="@color/color_ganancia" />

                        <TextView
                            android:id="@+id/tv_detalle_ultima"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_pequeno"
                            android:layout_weight="1"
                            android:textColor="@color/color_texto_principal"
                            android:textSize="@dimen/texto_cuerpo" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_nueva_operacion"
                style="@style/Estilo.Boton.Principal"
                android:layout_marginTop="@dimen/margen_seccion"
                android:text="@string/boton_nueva_operacion"
                app:icon="@drawable/ic_anadir" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_diario"
                style="@style/Estilo.Boton.Secundario"
                android:text="@string/boton_ver_diario"
                app:icon="@drawable/ic_diario" />

            <TextView
                style="@style/Estilo.Subtitulo.Nota"
                android:text="@string/nota_cuenta_demo" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
